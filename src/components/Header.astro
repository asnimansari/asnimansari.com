---
import { NAV, SITE } from '../consts';

const path = Astro.url.pathname;
const current = (p: string) => !p.startsWith('http') && path.startsWith(p);
---

<header class="site-header">
  <div class="shell">
    <a class="brand" href="/">{SITE.name}</a>
    <nav aria-label="Main">
      {
        NAV.map((item) => (
          <a
            href={item.path}
            aria-current={current(item.path) ? 'page' : undefined}
            {...(item.external ? { rel: 'noopener noreferrer', target: '_blank' } : {})}
          >
            {item.name}
          </a>
        ))
      }
      <button class="theme-btn" type="button" aria-label="Toggle light and dark theme" title="Toggle theme">
        <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
      </button>
    </nav>
  </div>
</header>
