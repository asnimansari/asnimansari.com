---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

// Only h2 and h3, nested one level deep.
const items = Astro.props.headings.filter((h) => h.depth === 2 || h.depth === 3);
const tree: { h: MarkdownHeading; children: MarkdownHeading[] }[] = [];
for (const h of items) {
  if (h.depth === 2 || tree.length === 0) tree.push({ h, children: [] });
  else tree[tree.length - 1].children.push(h);
}
---

{
  items.length >= 3 && (
    <details class="toc">
      <summary>Contents</summary>
      <ol>
        {tree.map(({ h, children }) => (
          <li>
            <a href={`#${h.slug}`}>{h.text}</a>
            {children.length > 0 && (
              <ol>
                {children.map((c) => (
                  <li>
                    <a href={`#${c.slug}`}>{c.text}</a>
                  </li>
                ))}
              </ol>
            )}
          </li>
        ))}
      </ol>
    </details>
  )
}
