---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const bookmarks = await getCollection('bookmarks');
---

<Base title="Bookmarks" description="Links worth keeping around.">
  <header class="g phead">
    <span class="lbl ink">Bookmarks · {bookmarks.length}</span>
    <div class="tt">
      <h1>Bookmarks. <span>Links I keep coming back to.</span></h1>
    </div>
  </header>
  <section class="g year">
    <ul class="rows" style="grid-column: 1 / -1">
      {bookmarks.map(({ data: b }) => (
        <li>
          <a class="with-dek" href={b.link} rel="noopener noreferrer"><b class="tt">{b.title}</b>{b.subtitle && <span class="dek">{b.subtitle}</span>}<span class="d">{b.badge}</span></a>
        </li>
      ))}
    </ul>
  </section>
</Base>
