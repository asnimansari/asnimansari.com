---
import '../styles/landing.css';
import { SITE, LINKS } from '../consts';

const firstName = SITE.name.split(' ')[0];

// Body copy for the home page. Inline links use plain anchors.
const paragraphs = [
  `I'm a senior backend engineer and Rustacean at <a href="https://sensibull.com">Sensibull</a> (by Zerodha), where I build and scale real-money trading systems.`,
  `I like distributed systems, low-latency infra, and the occasional side project. I'm also an avid typist. Check out my <a href="/resume/">resume</a> for the full story, or browse my <a href="/posts/">writing</a>.`,
];
---

<!doctype html>
<html lang={SITE.lang} data-theme="day">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{SITE.title}</title>
  <meta name="description" content={SITE.description} />
  <meta name="theme-color" content="#a8d8f0" />
  <link rel="canonical" href={`${SITE.url}/`} />
  <meta property="og:title" content={SITE.title} />
  <meta property="og:description" content={SITE.description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={`${SITE.url}/`} />
  <link rel="alternate" type="application/atom+xml" title="Posts" href="/posts/feed.xml" />

  <link rel="icon" type="image/png" sizes="32x32" href="/img/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/img/favicon-16x16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/img/apple-touch-icon.png" />

  <!-- Pick the sky before first paint so there is no flash of the wrong theme -->
  <script is:inline>
    (function () {
      var t;
      try { t = localStorage.getItem('sky'); } catch (e) {}
      if (!t) {
        var h = new Date().getHours();
        t = h >= 5 && h < 8 ? 'sunrise' : h >= 8 && h < 17 ? 'day' : h >= 17 && h < 19 ? 'sunset' : 'night';
      }
      document.documentElement.dataset.theme = t;
    })();
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500&family=Inter:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&display=swap" rel="stylesheet" />
</head>
<body>

  <!-- Reusable shapes -->
  <svg width="0" height="0" style="position:absolute" aria-hidden="true">
    <defs>
      <symbol id="cloud" viewBox="0 0 200 84">
        <circle cx="52" cy="58" r="24" />
        <circle cx="88" cy="42" r="32" />
        <circle cx="128" cy="46" r="28" />
        <circle cx="160" cy="60" r="20" />
        <rect x="40" y="56" width="130" height="26" rx="13" />
      </symbol>

      <g id="palm">
        <path style="fill:var(--trunk)" d="M-4,0 Q6,-70 16,-140 L23,-140 Q13,-70 7,0 Z" />
        <g class="fronds">
          <path style="fill:var(--palm)" d="M20,-140 Q-20,-168 -62,-130 Q-20,-150 20,-140Z" />
          <path style="fill:var(--palm)" d="M20,-140 Q62,-172 104,-128 Q60,-152 20,-140Z" />
          <path style="fill:var(--palm-dark)" d="M20,-140 Q-12,-132 -42,-88 Q-6,-124 20,-140Z" />
          <path style="fill:var(--palm-dark)" d="M20,-140 Q56,-130 82,-86 Q44,-124 20,-140Z" />
          <path style="fill:var(--palm)" d="M20,-140 Q14,-186 -12,-196 Q26,-176 20,-140Z" />
          <path style="fill:var(--palm-dark)" d="M20,-140 Q42,-182 74,-178 Q36,-166 20,-140Z" />
          <circle style="fill:var(--trunk)" cx="17" cy="-135" r="4" />
          <circle style="fill:var(--trunk)" cx="24" cy="-134" r="4" />
        </g>
      </g>

      <linearGradient id="mist" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="var(--mist)" stop-opacity="0" />
        <stop offset="1" stop-color="var(--mist)" stop-opacity="0.9" />
      </linearGradient>
    </defs>
  </svg>

  <!-- ========== SKY (fixed, behind everything) ========== -->
  <div class="sky" aria-hidden="true">
    <div class="stars"></div>
    <div class="stars2"></div>

    <div class="meteor-wrap"><span class="meteor" style="animation-delay:2s"></span></div>
    <div class="meteor-wrap"><span class="meteor" style="animation-delay:7s"></span></div>
    <div class="meteor-wrap"><span class="meteor" style="animation-delay:13s"></span></div>

    <div class="sun"></div>
    <div class="moon"></div>

    <!-- clouds: every one gets its own height, speed, size, opacity and start offset -->
    <div class="cloud" style="--y:6vh;  --w:220px; --dur:140s; --delay:-20s;  --o:.85; --bob:4px"><svg><use href="#cloud"/></svg></div>
    <div class="cloud" style="--y:16vh; --w:130px; --dur:110s; --delay:-75s;  --o:.7;  --bob:3px"><svg><use href="#cloud"/></svg></div>
    <div class="cloud" style="--y:28vh; --w:260px; --dur:170s; --delay:-110s; --o:.6;  --bob:5px"><svg><use href="#cloud"/></svg></div>
    <div class="cloud" style="--y:10vh; --w:160px; --dur:125s; --delay:-5s;   --o:.75; --bob:3px"><svg><use href="#cloud"/></svg></div>
    <div class="cloud" style="--y:38vh; --w:190px; --dur:155s; --delay:-60s;  --o:.55; --bob:4px"><svg><use href="#cloud"/></svg></div>
    <div class="cloud" style="--y:22vh; --w:110px; --dur:95s;  --delay:-40s;  --o:.8;  --bob:2px"><svg><use href="#cloud"/></svg></div>

    <!-- bird flocks -->
    <svg class="flock" style="--y:14vh; --dur:48s; --delay:-8s"  viewBox="0 0 70 30">
      <g transform="translate(0 10)"><path class="bird" d="M0 6 Q5 0 10 6 Q15 0 20 6" style="animation-delay:-.1s"/></g>
      <g transform="translate(22 0)"><path class="bird" d="M0 6 Q5 0 10 6 Q15 0 20 6" style="animation-delay:-.3s"/></g>
      <g transform="translate(40 14) scale(.8)"><path class="bird" d="M0 6 Q5 0 10 6 Q15 0 20 6"/></g>
    </svg>
    <svg class="flock" style="--y:24vh; --dur:62s; --delay:-35s" viewBox="0 0 70 30">
      <g transform="translate(0 4) scale(.8)"><path class="bird" d="M0 6 Q5 0 10 6 Q15 0 20 6" style="animation-delay:-.2s"/></g>
      <g transform="translate(24 12) scale(.7)"><path class="bird" d="M0 6 Q5 0 10 6 Q15 0 20 6"/></g>
    </svg>
    <svg class="flock" style="--y:8vh; --dur:75s; --delay:-50s" viewBox="0 0 70 30">
      <g transform="translate(10 8) scale(.6)"><path class="bird" d="M0 6 Q5 0 10 6 Q15 0 20 6" style="animation-delay:-.15s"/></g>
    </svg>

    <!-- plane with contrail -->
    <div class="plane-run">
      <div class="trail"></div>
      <svg class="plane" viewBox="0 0 40 14">
        <path d="M2 7 L30 6 Q38 6.5 38 7 Q38 7.5 30 8 L2 7Z M16 6.6 L10 1 L13 1 L22 6.4Z M16 7.4 L10 13 L13 13 L22 7.6Z M3 7 L0 3.5 L2 3.5 L6 6.8Z" />
        <circle class="beacon" cx="37" cy="7" r="1.2" />
      </svg>
    </div>

    <!-- a kite, because it's an Indian sky -->
    <div class="kite-wrap">
      <svg class="kite" viewBox="0 0 120 320">
        <path class="string" d="M40 52 Q60 180 -40 330" />
        <g class="kite-body">
          <path d="M40 0 L70 30 L40 60 L10 30Z" style="fill:var(--kite-a)" />
          <path d="M40 0 L70 30 L40 30Z" style="fill:var(--kite-b)" />
          <path d="M40 60 L10 30 L40 30Z" style="fill:var(--kite-b)" />
          <path d="M34 66 L40 58 L46 66Z" style="fill:var(--kite-a)" />
        </g>
      </svg>
    </div>
  </div>

  <!-- ========== PAGE ========== -->
  <div class="page">
    <button class="theme-toggle" type="button" aria-label="Change the sky">
      <span class="dot" aria-hidden="true"></span><span class="label">Day</span>
    </button>

    <main>
      <h1 class="rise" style="--i:0">Hey, I&rsquo;m {firstName}.</h1>

      <nav class="rise" style="--i:1">
        <a href="/posts/">Writing</a>
        <a href="/books/">Books</a>
        <a href="/bookmarks/">Bookmarks</a>
        <a href="/resume/">Resume</a>
      </nav>

      <div class="prose">
        {paragraphs.map((p, i) => <p class="rise" style={`--i:${i + 2}`} set:html={p} />)}
        <p class="motto rise" style={`--i:${paragraphs.length + 2}`}>Build carefully. Ship often. Stay curious.</p>
      </div>

      <svg class="signature" viewBox="0 0 220 70" role="img" aria-label={firstName}>
        <text x="6" y="52">{firstName}</text>
      </svg>

      <ul class="social rise" style={`--i:${paragraphs.length + 3}`}>
        {LINKS.map((link) => <li><a href={link.url} target="_blank" rel="noreferrer noopener">{link.name}</a></li>)}
      </ul>
    </main>

    <!-- ========== LANDSCAPE ========== -->
    <div class="scene" aria-hidden="true">
      <svg viewBox="0 0 1600 400" preserveAspectRatio="xMidYMax slice">
        <!-- far ghats -->
        <path style="fill:var(--hill-far)" d="M0,230 C150,170 300,200 420,175 C560,145 700,190 820,165 C980,130 1120,185 1250,160 C1400,135 1500,170 1600,155 L1600,400 L0,400Z" />
        <rect x="0" y="150" width="1600" height="140" fill="url(#mist)" />
        <!-- near hills -->
        <path style="fill:var(--hill-mid)" d="M0,272 C200,244 350,262 520,250 C700,236 850,262 1000,250 C1200,234 1400,258 1600,246 L1600,400 L0,400Z" />

        <!-- far bank palms -->
        <g class="palms-far">
          <g transform="translate(70 290) scale(.42)"><g class="sway" style="--sd:7s"><use href="#palm"/></g></g>
          <g transform="translate(125 292) scale(.36)"><g class="sway" style="--sd:8s"><use href="#palm"/></g></g>
          <g transform="translate(460 290) scale(.4)"><g class="sway" style="--sd:6.5s"><use href="#palm"/></g></g>
          <g transform="translate(505 292) scale(.33)"><g class="sway" style="--sd:9s"><use href="#palm"/></g></g>
          <g transform="translate(880 290) scale(.44)"><g class="sway" style="--sd:7.5s"><use href="#palm"/></g></g>
          <g transform="translate(940 292) scale(.36)"><g class="sway" style="--sd:8.5s"><use href="#palm"/></g></g>
          <g transform="translate(1170 290) scale(.4)"><g class="sway" style="--sd:7s"><use href="#palm"/></g></g>
          <g transform="translate(1390 290) scale(.42)"><g class="sway" style="--sd:6.8s"><use href="#palm"/></g></g>
        </g>

        <!-- backwaters -->
        <path style="fill:var(--water)" d="M0,288 C400,280 1200,294 1600,284 L1600,346 C1200,340 400,352 0,342Z" />
        <g class="shimmer">
          <line x1="180" y1="300" x2="230" y2="300" style="--d:0s" />
          <line x1="620" y1="312" x2="690" y2="312" style="--d:1.2s" />
          <line x1="1040" y1="298" x2="1080" y2="298" style="--d:2.1s" />
          <line x1="1300" y1="318" x2="1370" y2="318" style="--d:.6s" />
          <line x1="360" y1="330" x2="410" y2="330" style="--d:1.7s" />
          <line x1="860" y1="326" x2="930" y2="326" style="--d:2.8s" />
        </g>

        <!-- houseboat (kettuvallam) drifting across -->
        <g class="boat">
          <g transform="translate(0 312)">
            <path style="fill:var(--boat)" d="M-6,-6 Q4,12 40,14 L150,14 Q182,12 194,-8 Q170,2 150,2 L40,2 Q14,2 -6,-6Z" />
            <path style="fill:var(--thatch)" d="M26,2 Q30,-26 90,-28 Q152,-26 160,2Z" />
            <rect class="win" x="58" y="-10" width="10" height="8" rx="2" />
            <rect class="win" x="84" y="-12" width="10" height="10" rx="2" />
            <rect class="win" x="110" y="-10" width="10" height="8" rx="2" />
          </g>
        </g>

        <!-- near bank -->
        <path style="fill:var(--ground)" d="M0,340 C300,330 600,352 900,342 C1200,332 1400,348 1600,338 L1600,400 L0,400Z" />

        <!-- tharavad-style house -->
        <g transform="translate(1220 352)">
          <rect style="fill:var(--wall)" x="0" y="-40" width="110" height="42" />
          <path style="fill:var(--roof)" d="M-18,-38 L20,-78 L90,-78 L128,-38Z" />
          <path style="fill:var(--roof-dark)" d="M30,-78 L55,-100 L80,-78Z" />
          <rect class="win" x="14" y="-28" width="16" height="16" rx="2" />
          <rect class="win" x="80" y="-28" width="16" height="16" rx="2" />
          <rect style="fill:var(--roof-dark)" x="46" y="-30" width="18" height="32" rx="2" />
        </g>

        <!-- foreground palms -->
        <g transform="translate(40 380) scale(1.05)"><g class="sway" style="--sd:6s"><use href="#palm"/></g></g>
        <g transform="translate(140 384) scale(.8)"><g class="sway" style="--sd:7.2s"><use href="#palm"/></g></g>
        <g transform="translate(1420 382) scale(.9)"><g class="sway" style="--sd:6.6s"><use href="#palm"/></g></g>
        <g transform="translate(1530 386) scale(1.1)"><g class="sway" style="--sd:5.8s"><use href="#palm"/></g></g>

        <!-- fireflies (night only) -->
        <g class="fireflies">
          <circle cx="260" cy="360" r="2.2" style="--d:0s" />
          <circle cx="330" cy="370" r="1.8" style="--d:1.3s" />
          <circle cx="1120" cy="362" r="2" style="--d:.7s" />
          <circle cx="1360" cy="372" r="1.8" style="--d:2.2s" />
          <circle cx="700" cy="366" r="2" style="--d:1.8s" />
        </g>
      </svg>
    </div>
  </div>

  <script>
    import '../scripts/landing.js';
  </script>
</body>
</html>
