---
import Base from '../layouts/Base.astro';
import { SITE, LINKS } from '../consts';
import { getPosts, formatDate, isoDate } from '../lib/posts';

const [cover, ...rest] = await getPosts();
const also = rest.slice(0, 3);
const firstName = SITE.name.split(' ')[0];
---

<Base>
  <section class="g hero">
    <figure class="pic">
      <img src="/img/avatar.jpg" alt="" width="420" height="420" decoding="async" fetchpriority="high" />
    </figure>
    <div class="say">
      <h1>Hey, I’m {firstName}. <span>I build real-money trading systems in Rust and Golang.</span></h1>
      <p class="stand">
        I’m a senior backend engineer and Rustacean at <a href="https://sensibull.com">Sensibull</a> (by Zerodha). I like distributed systems, low-latency infra, and the occasional side project. Read the <a href="/resume/">resume</a> for the full story, or browse the <a href="/posts/">writing</a>.
      </p>
    </div>
  </section>

  {cover && (
    <section class="g writing" aria-labelledby="h-writing">
      <h2 class="colh" id="h-writing"><span><span class="num">01</span>Writing</span><a class="more" href="/posts/">All posts</a></h2>
      <article class="cover">
        <span class="lbl"><time datetime={isoDate(cover.data.date)}>{formatDate(cover.data.date)}</time></span>
        <h3><a href={`/posts/${cover.id}/`}>{cover.data.title}</a></h3>
        <p class="dek">{cover.data.description}</p>
      </article>
      <div class="also">
        {also.map((p) => (
          <article>
            <span class="lbl"><time datetime={isoDate(p.data.date)}>{formatDate(p.data.date)}</time></span>
            <h3><a href={`/posts/${p.id}/`}>{p.data.title}</a></h3>
            <p class="dek">{p.data.description}</p>
          </article>
        ))}
      </div>
    </section>
  )}

  <section class="g writing" aria-labelledby="h-elsewhere">
    <h2 class="colh" id="h-elsewhere"><span><span class="num">02</span>Elsewhere</span></h2>
    <ul class="rows">
      <li><a href="/books/"><b>Books</b><span class="dek">What I’ve read and would recommend.</span><span class="d">→</span></a></li>
      <li><a href="/bookmarks/"><b>Bookmarks</b><span class="dek">Links I keep coming back to.</span><span class="d">→</span></a></li>
      <li><a href="/travel/"><b>Travel</b><span class="dek">A map of the countries I’ve been to.</span><span class="d">→</span></a></li>
      {LINKS.map((l) => <li><a href={l.url}><b>{l.name}</b><span class="dek"></span><span class="d">↗</span></a></li>)}
    </ul>
  </section>
</Base>
