---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { md } from '../lib/md';

const [experience, projects, education] = await Promise.all([
  getCollection('experience'),
  getCollection('projects'),
  getCollection('education'),
]);

const summary =
  "Senior backend engineer with 8 years of experience building and scaling real-money trading systems in Rust and Golang at Sensibull (by Zerodha), India's largest options trading platform with 13M+ registered users and ~200K daily active traders. First non-founding engineering hire; owned core systems end to end (order management, payments, real-time market data, notifications, and broker integrations) from architecture through production operations on AWS. Proven record of designing high-throughput, low-latency distributed systems (200K+ orders/day, p90 latency cut from 5s to milliseconds).";

const skills: [string, string][] = [
  ['Programming Languages', 'Rust, Golang, Python, JavaScript, Java, C#, SQL'],
  ['Frameworks & Libraries', 'Axum, Tokio, SQLx, REST APIs, WebSockets, Celery, React, HTML/CSS, Ruby on Rails'],
  ['Databases', 'PostgreSQL, Redis'],
  ['Tools & Infra', 'Kafka, NATS, AWS SQS, AWS, Terraform, Docker, Kubernetes, Jenkins, AWS CodeBuild, CI/CD'],
  ['Cloud', 'AWS (ECS, EC2, RDS, MSK, SQS, Route53, CloudWatch, Athena, Parameter Store)'],
  [
    'Other',
    'Distributed systems design, event-driven architecture, idempotent processing, observability, production debugging, mentoring, technical interviewing, AI agents, LLMs, orchestration, RAG, tool/function calling, knowledge infrastructure, API design',
  ],
];

const sections: [string, (typeof experience)[number][] | (typeof projects)[number][] | (typeof education)[number][]][] = [
  ['Experience', experience],
  ['Projects', projects],
  ['Education', education],
];
---

<Base title="Asnim Ansari Resume" description="Resume of Asnim Ansari">
  <header class="g phead">
    <span class="lbl ink">Resume</span>
    <div class="tt">
      <h1>Asnim Ansari. <span>Senior Backend Engineer.</span></h1>
      <p>{summary}</p>
    </div>
  </header>

  {sections.map(([label, items], i) => (
    <section class="g cv" aria-label={label}>
      <h2 class="gl"><span class="num">0{i + 1}</span>{label}</h2>
      <div class="list">
        {items.map(({ data: it }) => (
          <div class="item">
            <h3>{it.link ? <a href={it.link} rel="noopener noreferrer">{it.title}</a> : it.title}</h3>
            {it.badge && <span class="lbl">{it.badge}</span>}
            {it.subtitle && <p class="sub">{it.subtitle}</p>}
            {it.content && <div class="prose" set:html={md(it.content)} />}
            {it.tags.length > 0 && <p class="lbl tags">{it.tags.join(' · ')}</p>}
          </div>
        ))}
      </div>
    </section>
  ))}

  <section class="g cv" aria-label="Skills">
    <h2 class="gl"><span class="num">04</span>Skills</h2>
    <div class="list">
      {skills.map(([label, value]) => <div class="item"><h3>{label}</h3><p class="sub">{value}</p></div>)}
    </div>
  </section>

  <section class="g cv" aria-label="Contact">
    <h2 class="gl"><span class="num">05</span>Contact</h2>
    <div class="list">
      <div class="item">
        <p class="sub">Bengaluru, Karnataka, India · <a href="tel:+919446791878">+91 94467 91878</a> · <a href="mailto:asnim96@gmail.com">asnim96@gmail.com</a> · <a href="https://github.com/asnimansari">GitHub</a> · <a href="https://linkedin.com/in/asnimansari">LinkedIn</a></p>
      </div>
    </div>
  </section>
</Base>
